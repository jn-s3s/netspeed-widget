# Rust build and release packaging artifacts
target/
dist/

# Archived Python build artifacts (legacy/), including older root-level builds
build/
*.spec
__pycache__/

# Optional fast.com runtime, generated by the archived legacy/build.py.
# Standard Rust release packages do not include Node or the npm tree.
third_party/node/
third_party/fast-bundle/node_modules/

# Others
/config.json

# Archived Python test and linter caches
.pytest_cache/
.ruff_cache/
.venv/
